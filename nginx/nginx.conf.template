worker_processes 1;
events { worker_connections 1024; }

http {
  upstream app_pool {
    server app_blue:3000  max_fails=1 fail_timeout=2s<<BLUE_FLAGS>>;
    server app_green:3000 max_fails=1 fail_timeout=2s<<GREEN_FLAGS>>;
    keepalive 32;
  }

  server {
    listen 80;

    proxy_connect_timeout 200ms;
    proxy_send_timeout    1s;
    proxy_read_timeout    1s;
    proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
    proxy_next_upstream_timeout 3s;
    proxy_next_upstream_tries 2;

    location / {
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_pass http://app_pool;
    }

    location = /nginx_healthz { access_log off; return 200 'ok'; }
    location /version { proxy_pass http://app_pool/version; }
    location /healthz { proxy_pass http://app_pool/healthz; }
    location /chaos/  { proxy_pass http://app_pool/chaos/; }
  }
}
